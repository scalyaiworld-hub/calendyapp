# Copia este archivo a .env y completa los valores de tu proyecto de Supabase
# (Project Settings -> API). Solo van valores PÚBLICOS: URL, ID y clave publishable.
# NUNCA pongas aquí la service role key, el JWT secret ni la contraseña de Postgres.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Solo en el servidor (variables del hosting, nunca en el repositorio):
# SUPABASE_SERVICE_ROLE_KEY=""

# Anti-bots de la reserva pública (Cloudflare Turnstile). Sin estas claves el captcha no se exige.
# VITE_TURNSTILE_SITE_KEY=""        # pública (va al navegador)
# TURNSTILE_SECRET_KEY=""           # solo servidor
# BOOKING_IP_SALT=""                # solo servidor: sal para guardar las IP con hash

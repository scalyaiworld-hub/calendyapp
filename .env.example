# Copia este archivo a .env y completa los valores de tu proyecto de Supabase
# (Project Settings -> API). Solo van valores PÚBLICOS: URL, ID y clave publishable.
# NUNCA pongas aquí la service role key, el JWT secret ni la contraseña de Postgres.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Solo en el servidor (variables del hosting, nunca en el repositorio):
# SUPABASE_SERVICE_ROLE_KEY=""

# Recordatorios por email (solo servidor, variables del hosting):
# RESEND_API_KEY=""
# REMINDERS_FROM="Calendya <recordatorios@tu-dominio.com>"
# REMINDERS_CRON_SECRET=""   # mínimo 16 caracteres; el mismo valor que usa el cron
